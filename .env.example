# TiKiT OS - Environment Variables Template
# Copy this file to .env.local and fill in your actual values
# DO NOT commit .env.local to version control

# =============================================================================
# SUPABASE CONFIGURATION (Required)
# =============================================================================

# Get these from your Supabase project settings:
# https://app.supabase.com/project/{your-project-id}/settings/api

# Public Supabase URL (safe for client-side)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Public anon/public key (safe for client-side)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ⚠️ SERVER-ONLY SECRET - Never expose to client-side code
# This is used for admin operations and bypassing RLS
# ONLY use in Next.js API routes, server components, or edge functions
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# =============================================================================
# AI/ML CONFIGURATION
# =============================================================================

# Google Gemini API Key (for AI brief processing and strategy generation)
# Get your key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Alternative: OpenAI API Key (if using OpenAI instead of Gemini)
# OPENAI_API_KEY=your-openai-api-key-here

# Alternative: Anthropic API Key (if using Claude)
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Application URLs (public - safe for client)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api/trpc

# Node environment
NODE_ENV=development

# =============================================================================
# FEATURE FLAGS (Optional)
# =============================================================================

# Enable/disable AI features
NEXT_PUBLIC_ENABLE_AI=true

# Enable/disable analytics
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# Enable/disable real-time features
NEXT_PUBLIC_ENABLE_REALTIME=true

# =============================================================================
# EXTERNAL SERVICES (Optional)
# =============================================================================

# Sentry for error tracking (optional)
# SENTRY_DSN=your-sentry-dsn-here
# NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn-here

# LogRocket for session replay (optional)
# LOGROCKET_APP_ID=your-logrocket-app-id-here

# =============================================================================
# EMAIL CONFIGURATION (Optional - for production)
# =============================================================================

# SMTP settings for transactional emails
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=your-sendgrid-api-key
# SMTP_FROM_EMAIL=noreply@tikit-os.com
# SMTP_FROM_NAME=TiKiT OS

# =============================================================================
# OAUTH PROVIDERS (Optional)
# =============================================================================

# Google OAuth
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth
# GITHUB_CLIENT_ID=your-github-client-id
# GITHUB_CLIENT_SECRET=your-github-client-secret

# =============================================================================
# DEPLOYMENT (Production only - set in Vercel dashboard)
# =============================================================================

# These are automatically populated by Vercel:
# VERCEL_URL - Auto-populated by Vercel
# VERCEL_ENV - Auto-populated by Vercel (production, preview, development)
# VERCEL_GIT_COMMIT_SHA - Auto-populated by Vercel

# =============================================================================
# DATABASE (Local development with Supabase CLI)
# =============================================================================

# When using local Supabase via `supabase start`:
# NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<from supabase start output>
# SUPABASE_SERVICE_ROLE_KEY=<from supabase start output>

# =============================================================================
# SECURITY NOTES
# =============================================================================

# ⚠️ NEVER commit this file with real values to version control
# ⚠️ NEVER expose SUPABASE_SERVICE_ROLE_KEY to client-side code
# ⚠️ NEVER expose API keys (GEMINI_API_KEY, etc.) to client-side code
# ⚠️ Only use NEXT_PUBLIC_* variables for client-safe values
# ⚠️ For Expo mobile app, use EXPO_PUBLIC_* instead of NEXT_PUBLIC_*

# =============================================================================
# SETUP INSTRUCTIONS
# =============================================================================

# 1. Copy this file:
#    cp .env.example .env.local
#
# 2. Get Supabase credentials:
#    - Create project at https://app.supabase.com
#    - Go to Settings > API
#    - Copy URL and anon key to NEXT_PUBLIC_* variables
#    - Copy service_role key to SUPABASE_SERVICE_ROLE_KEY
#
# 3. Get Gemini API key:
#    - Go to https://makersuite.google.com/app/apikey
#    - Create new API key
#    - Copy to GEMINI_API_KEY
#
# 4. Configure app URL:
#    - For local dev: http://localhost:3000
#    - For production: https://your-domain.com
#
# 5. Enable features as needed:
#    - Set NEXT_PUBLIC_ENABLE_* flags
#
# 6. For mobile app:
#    - Copy mobile-specific env to apps/mobile/.env.local
#    - Use EXPO_PUBLIC_* prefix instead of NEXT_PUBLIC_*
