# PrecisionFlow - Web App Environment Variables
# Copy this file to .env.local and fill in your values
# ──────────────────────────────────────────────────────

# ── Supabase (public - safe for client) ──
# Get these from: https://app.supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ── Supabase (server-only secret) ──
# ⚠️ Never expose to client-side code
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Google Gemini AI (server-only secret) ──
# Get API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# ── App URLs (public - safe for client) ──
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Feature Flags (public - safe for client) ──
NEXT_PUBLIC_ENABLE_AI=true
NEXT_PUBLIC_ENABLE_ANALYTICS=false
