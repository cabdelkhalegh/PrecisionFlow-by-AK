{
  "name": "precisionflow",
  "version": "1.0.0",
  "private": true,
  "description": "PrecisionFlow - Campaign Execution & Intelligence Platform",
  "keywords": [
    "influencer-marketing",
    "campaign-management",
    "ai-powered"
  ],
  "homepage": "https://github.com/cabdelkhalegh/PrecisionFlow-by-AK#readme",
  "bugs": {
    "url": "https://github.com/cabdelkhalegh/PrecisionFlow-by-AK/issues"
  },
  "license": "UNLICENSED",
  "author": "PrecisionFlow by AK",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=web",
    "dev:mobile": "turbo run dev --filter=mobile",
    "dev:docs": "turbo run dev --filter=docs",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=web",
    "build:mobile": "turbo run build --filter=mobile",
    "test": "turbo run test",
    "test:web": "turbo run test --filter=web --filter=api",
    "test:mobile": "turbo run test --filter=@precisionflow/mobile",
    "test:unit": "turbo run test:unit",
    "test:e2e": "turbo run test:e2e",
    "test:watch": "turbo run test:watch",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint --fix",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\"",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter=database generate",
    "db:migrate": "pnpm --filter=database migrate",
    "db:seed": "pnpm --filter=database seed",
    "db:reset": "pnpm --filter=database reset",
    "clean": "turbo run clean && rm -rf node_modules",
    "clean:modules": "find . -name 'node_modules' -type d -prune -exec rm -rf '{}' +",
    "setup": "bash scripts/setup-env.sh",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@types/node": "^20.11.17",
    "eslint": "^8.56.0",
    "husky": "^9.0.10",
    "lint-staged": "^15.2.2",
    "prettier": "^3.2.5",
    "turbo": "^1.12.4",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.9"
}
